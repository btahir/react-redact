{
	"name": "react-redact",
	"version": "0.3.0",
	"description": "Local demo data, visual field policies, and a small React redaction toolkit.",
	"author": "Bilal Tahir",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/btahir/react-redact.git"
	},
	"homepage": "https://react-redact.vercel.app",
	"bugs": {
		"url": "https://github.com/btahir/react-redact/issues"
	},
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./styles.css": "./dist/styles/redact.css",
		"./package.json": "./package.json",
		"./data": {
			"import": {
				"types": "./dist/data.d.ts",
				"default": "./dist/data.js"
			},
			"require": {
				"types": "./dist/data.d.cts",
				"default": "./dist/data.cjs"
			}
		},
		"./fields": {
			"import": {
				"types": "./dist/fields.d.ts",
				"default": "./dist/fields.js"
			},
			"require": {
				"types": "./dist/fields.d.cts",
				"default": "./dist/fields.cjs"
			}
		},
		"./studio": {
			"import": {
				"types": "./dist/studio.d.ts",
				"default": "./dist/studio.js"
			},
			"require": {
				"types": "./dist/studio.d.cts",
				"default": "./dist/studio.cjs"
			}
		},
		"./diagnostics": {
			"import": {
				"types": "./dist/diagnostics.d.ts",
				"default": "./dist/diagnostics.js"
			},
			"require": {
				"types": "./dist/diagnostics.d.cts",
				"default": "./dist/diagnostics.cjs"
			}
		},
		"./studio.css": "./dist/styles/studio.css",
		"./schema.json": "./schema/demo.schema.json",
		"./playwright": {
			"import": {
				"types": "./scripts/playwright.d.ts",
				"default": "./scripts/playwright.mjs"
			},
			"require": {
				"types": "./scripts/playwright.d.cts",
				"default": "./scripts/playwright.cjs"
			}
		}
	},
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"scripts/cli.mjs",
		"scripts/playwright.mjs",
		"scripts/playwright.d.ts",
		"schema",
		"skills",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"scripts/playwright.cjs",
		"scripts/playwright.d.cts"
	],
	"sideEffects": [
		"*.css"
	],
	"keywords": [
		"react",
		"redact",
		"pii",
		"privacy",
		"blur",
		"mask",
		"demo-mode",
		"screenshare",
		"sensitive-data",
		"synthetic-data",
		"demo-data",
		"visual-editor",
		"developer-tools"
	],
	"peerDependencies": {
		"react": ">=18.0.0",
		"react-dom": ">=18.0.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.17.0",
		"@biomejs/biome": "^2.3.0",
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.27.0",
		"@playwright/test": "^1.63.0",
		"@size-limit/preset-small-lib": "^11.0.0",
		"@testing-library/jest-dom": "^6.0.0",
		"@testing-library/react": "^16.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitest/coverage-v8": "^3.2.4",
		"jsdom": "^25.0.0",
		"publint": "^0.3.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"size-limit": "^11.0.0",
		"tsup": "^8.5.1",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	},
	"size-limit": [
		{
			"path": "dist/index.js",
			"limit": "5 kB"
		}
	],
	"scripts": {
		"build": "tsup && node scripts/postbuild.mjs",
		"dev": "tsup --watch",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"check": "biome check .",
		"check:fix": "biome check --fix .",
		"lint:pkg": "publint && attw --pack --profile node16 --exclude-entrypoints ./styles.css ./studio.css",
		"size": "size-limit",
		"docs": "pnpm --filter react-redact-docs dev",
		"video": "pnpm --filter react-redact-video studio",
		"video:render": "pnpm --filter react-redact-video render:all",
		"prepublishOnly": "pnpm run build",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "pnpm run build && changeset publish",
		"typecheck": "tsc --noEmit",
		"validate": "pnpm build && pnpm typecheck && pnpm test:run && pnpm lint:pkg",
		"test:e2e": "playwright test",
		"test:package": "node scripts/test-package.mjs"
	},
	"bin": {
		"redact": "./scripts/cli.mjs"
	},
	"engines": {
		"node": ">=18"
	},
	"funding": {
		"type": "custom",
		"url": "https://react-tourlight.vercel.app/support"
	}
}
